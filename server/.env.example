# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amplify_crm?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Google Workspace SSO
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_ALLOWED_DOMAIN="company.com"

# Google Workspace API (Drive, Gmail, Calendar, Contacts) — service account JSON key (minified)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
GMAIL_SENDER="crm@yourdomain.com"
GOOGLE_CALENDAR_ID="primary"

# Gemini AI (for proposal generation, lead gen, etc.)
GEMINI_API_KEY="your-gemini-api-key"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Paystack
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"

# Mobiwave SMS
MOBIWAVE_API_KEY="your-mobiwave-api-key"
MOBIWAVE_SENDER_ID="your-sender-id"
SMS_API_TOKEN="your-sms-api-token"

# CORS — JSON array or comma-separated list of allowed origins
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://localhost:4173"]'

# App URL (used in email links, etc.)
APP_URL="http://localhost:5173"

# Server
PORT=3001
NODE_ENV=development
